<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - Inventory Management</title>

    <style>
        * {
            box-sizing: border-box;
        }

        body {
            margin: 0;
            font-family: Arial, sans-serif;
            background: #f4f7fb;
            color: #263247;
        }

        .navbar {
            background: #172554;
            color: white;
            padding: 20px 6%;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

            .navbar h2 {
                margin: 0;
                font-size: 23px;
            }

            .navbar span {
                color: #bfdbfe;
                font-size: 14px;
            }

        .container {
            max-width: 1100px;
            margin: 35px auto;
            padding: 0 20px;
        }

        .page-footer {
            text-align: center;
            color: #64748b;
            padding: 20px;
            font-size: 14px;
        }

        h2 {
            color: #172554;
        }

        input[type="text"],
        input[type="number"],
        select,
        textarea {
            width: 100%;
            padding: 11px;
            margin-top: 6px;
            border: 1px solid #cbd5e1;
            border-radius: 6px;
            font-size: 15px;
        }

        input:focus {
            outline: 2px solid #bfdbfe;
            border-color: #2563eb;
        }

        input[type="submit"],
        button {
            background: #2563eb;
            color: white;
            border: none;
            border-radius: 6px;
            padding: 11px 18px;
            cursor: pointer;
            font-size: 14px;
        }

            input[type="submit"]:hover,
            button:hover {
                background: #1d4ed8;
            }

        a {
            color: #2563eb;
        }

        .table {
            width: 100%;
            border-collapse: collapse;
            background: white;
            margin-top: 20px;
            border-radius: 8px;
            overflow: hidden;
        }

            .table th {
                background: #e8eef9;
                color: #172554;
                text-align: left;
            }

            .table th,
            .table td {
                padding: 15px;
                border-bottom: 1px solid #e2e8f0;
            }

            .table tr:last-child td {
                border-bottom: none;
            }

            .table tr:hover {
                background: #f8fafc;
            }

        .form-card {
            max-width: 600px;
            margin: 0 auto;
            background: white;
            padding: 28px;
            border-radius: 10px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.06);
        }

        .form-group {
            margin-bottom: 18px;
        }

        .btn-add {
            display: inline-block;
            padding: 11px 17px;
            background: #2563eb;
            color: white;
            text-decoration: none;
            border-radius: 6px;
        }

            .btn-add:hover {
                background: #1d4ed8;
                color: white;
            }

        .btn-edit {
            color: #2563eb;
            font-weight: bold;
        }

        .btn-delete {
            color: #dc2626;
            font-weight: bold;
        }

        @@media (max-width: 700px) {
            .navbar {
                padding: 18px;
            }

            .container {
                margin: 20px auto;
                padding: 0 12px;
                overflow-x: auto;
            }

            .table {
                min-width: 650px;
            }
        }
    </style>
</head>

<body>

    <header class="navbar">
        <h2>📦 Inventory Management</h2>
        <span>Product & Stock Control</span>
    </header>

    <main class="container">
        @RenderBody()
    </main>

    <footer class="page-footer">
        Inventory Management System | ASP.NET MVC & ADO.NET
    </footer>

    @RenderSection("scripts", required: false)

</body>
</html>