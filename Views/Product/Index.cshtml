@model IEnumerable<InventoryManagement.Models.Product>

@{
    ViewBag.Title = "Product Inventory";
}

<div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:25px;">
    <div>
        <h2 style="margin-bottom:6px;">Product Inventory</h2>
        <p style="color:#64748b; margin:0;">Manage your products and stock.</p>
    </div>

    @Html.ActionLink("+ Add Product", "Create", null, new { @class = "btn-add" })
</div>

<div style="background:white; padding:20px; border-radius:8px; margin-bottom:20px; border:1px solid #e2e8f0;">
    <h3 style="margin:0; color:#172554;">Total Products</h3>
    <p style="font-size:28px; font-weight:bold; margin:10px 0 0;">
        @(Model == null ? 0 : Model.Count())
    </p>
</div>

<table class="table">
    <thead>
        <tr>
            <th>ID</th>
            <th>Product Name</th>
            <th>Category</th>
            <th>Quantity</th>
            <th>Price</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.ProductId</td>
                <td><strong>@item.ProductName</strong></td>
                <td>@item.Category</td>
                <td>@item.Quantity</td>
                <td>₹@item.Price.ToString("N2")</td>
                <td>
                    @Html.ActionLink("Edit", "Edit",
                             new { id = item.ProductId },
                             new { @class = "btn-edit" })

                    &nbsp; | &nbsp;

                    @Html.ActionLink("Delete", "Delete",
                             new { id = item.ProductId },
                             new
                             {
                                 @class = "btn-delete",
                                 onclick = "return confirm('Are you sure you want to delete this product?');"
                             })
                </td>
            </tr>
        }
    </tbody>
</table>